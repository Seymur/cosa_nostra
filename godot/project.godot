; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cosa Nostra"
run/main_scene="uid://b76xf6p6j7ydw"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GUIDE="*uid://p2jwrgjcbexr"
GameClock="*uid://b1f5ae7urcdis"
Localization="*res://globals/localization.gd"

[display]

window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/guide/plugin.cfg")

[internationalization]

locale/fallback="en"
locale/translations=PackedStringArray("res://localization/translations.en.translation", "res://localization/translations.az.translation", "res://localization/translations.tr.translation", "res://localization/translations.ru.translation", "res://localization/translations.uk.translation", "res://localization/translations.de.translation", "res://localization/translations.fr.translation", "res://localization/translations.es.translation", "res://localization/translations.it.translation", "res://localization/translations.pt_BR.translation", "res://localization/translations.pl.translation", "res://localization/translations.ja.translation", "res://localization/translations.zh_CN.translation")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_2d=3
anti_aliasing/quality/msaa_3d=3
anti_aliasing/quality/use_debanding=true
anti_aliasing/quality/screen_space_aa=2
anti_aliasing/quality/use_taa=true
